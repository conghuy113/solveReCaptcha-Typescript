{
  "name": "@conghuy113/recaptcha-solver",
  "version": "0.1.0",
  "description": "AGPL TypeScript client for solving reCAPTCHA in an already-open Chrome browser",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conghuy113/solveReCaptchaByAIVision.git",
    "directory": "npm/recaptcha-solver"
  },
  "homepage": "https://github.com/conghuy113/solveReCaptchaByAIVision#readme",
  "bugs": {
    "url": "https://github.com/conghuy113/solveReCaptchaByAIVision/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "model-manifest.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/postinstall.ts --format esm --dts --sourcemap --clean",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:cdp": "tsx scripts/cdp-smoke.ts",
    "smoke:solve": "tsx scripts/solve-smoke.ts",
    "postinstall": "node ./dist/postinstall.js",
    "prepack": "tsup src/index.ts src/postinstall.ts --format esm --dts --sourcemap --clean"
  },
  "dependencies": {
    "onnxruntime-node": "1.27.0",
    "sharp": "0.35.3",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
